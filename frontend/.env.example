# Environment Configuration for APM Jambi Website
# Development (Local Proxy):
VITE_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000

# Production Deployment (Domain Kredibel .or.id / .id / .com):
# Example with separate API subdomain:
# VITE_API_URL=https://api.apmjambi.or.id/api
# Or same-origin reverse proxy:
# VITE_API_URL=/api
